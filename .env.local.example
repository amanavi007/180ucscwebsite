# Supabase project settings -> API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role key -- server-only, never expose to the client.
# Used for admin bulk-create / password reset (Supabase Admin API).
SUPABASE_SERVICE_ROLE_KEY=

# Cloudflare Turnstile -- bot guard on the public coffee chat booking form.
# Sign up at https://dash.cloudflare.com/?to=/:account/turnstile
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Resend -- fallback sender (or primary if Gmail below is unset) for
# transactional email (booking confirmations, exec notifications). https://resend.com/api-keys. EMAIL_FROM must be an
# address on your verified Resend domain.
RESEND_API_KEY=
EMAIL_FROM="180 Degrees Consulting UCSC <bookings@yourdomain.com>"

# Preferred sender while the Resend domain is new (better inbox placement);
# if it fails, Resend is tried. Sends from a Google account.
# Turn on 2-Step Verification, then create an app password at
# https://myaccount.google.com/apppasswords (16 characters, no spaces).
# Set EMAIL_PROVIDER=resend or gmail to use that one alone with no fallback.
GMAIL_USER=
GMAIL_APP_PASSWORD=
EMAIL_PROVIDER=
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Vercel Cron -- protects /api/cron/* routes (attendance and interview reminder emails).
# Any long random string (e.g. `openssl rand -hex 32`); also set it in the
# Vercel project's environment variables. Vercel sends it as a Bearer token.
CRON_SECRET=

# --- AI assistant ---
# Free-tier keys only. Gemini: https://aistudio.google.com/apikey  Groq: https://console.groq.com/keys
GOOGLE_GENERATIVE_AI_API_KEY=
GROQ_API_KEY=
# Optional model overrides (defaults: gemini-flash-lite-latest, openai/gpt-oss-120b)
ASSISTANT_MODEL=
ASSISTANT_FALLBACK_MODEL=
# Optional caps (defaults: 30 per user/day, 200 global/day). Set the global cap just under your provider's free quota.
ASSISTANT_USER_DAILY_CAP=
ASSISTANT_GLOBAL_DAILY_CAP=

# --- Prelim reviewer (Google Drive picker) ---
# Google Cloud console: create a project, enable "Google Drive API", "Google Slides API" and "Google Picker API".
# APIs & Services > Credentials: an OAuth client ID (Web application) with the portal origins
# (http://localhost:3000 and the production URL) as Authorized JavaScript origins, and an API key
# restricted to the Picker API and those origins. OAuth consent screen: add the scope .../auth/drive.file.
# App ID is the numeric Cloud project number (Project settings). All three are public by design.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
NEXT_PUBLIC_GOOGLE_PICKER_API_KEY=
NEXT_PUBLIC_GOOGLE_APP_ID=
