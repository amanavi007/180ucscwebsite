# Supabase project settings -> API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role key -- server-only, never expose to the client.
# Used for admin bulk-create / password reset (Supabase Admin API).
SUPABASE_SERVICE_ROLE_KEY=

# Cloudflare Turnstile -- bot guard on the public coffee chat booking form.
# Sign up at https://dash.cloudflare.com/?to=/:account/turnstile
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Resend -- transactional email for coffee chat booking confirmations.
# https://resend.com/api-keys, and verify a sending domain before real launch.
RESEND_API_KEY=
COFFEE_CHAT_FROM_EMAIL=

# Alternative to Resend that needs no domain: send from a Google account.
# Turn on 2-Step Verification, then create an app password at
# https://myaccount.google.com/apppasswords (16 characters, no spaces).
# If GMAIL_USER is set, Gmail is used; set EMAIL_PROVIDER=resend to force Resend.
GMAIL_USER=
GMAIL_APP_PASSWORD=
EMAIL_PROVIDER=
NEXT_PUBLIC_SITE_URL=http://localhost:3000
